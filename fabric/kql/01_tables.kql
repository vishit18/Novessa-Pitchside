// Novessa Pitchside in a Fabric Eventhouse: tables, mapping and update policies.
// Run once in the KQL database `pitchside` (Eventhouse > KQL database > Explore your data),
// one command block at a time (select it, Shift+Enter). Safe to re-run.
//
// Every Event Hubs message is the bus envelope from backend/bus/base.py:
//   {"match_id": "...", "kind": "event" | "frame", "t_match": 1607.2,
//    "published_at": 1792771200.123, "payload": { MatchEvent or TrackingFrame }}
// The Eventstream lands it as it is in PitchsideRaw. Update policies split it into typed
// tables, so dashboards never parse JSON. Synthetic data only (docs/03): no real match.

// ---- landing table ----------------------------------------------------------------------

.create-merge table PitchsideRaw (
    match_id: string,
    kind: string,
    t_match: real,
    published_at: real,
    payload: dynamic
)

.create-or-alter table PitchsideRaw ingestion json mapping "PitchsideRawMapping"
```
[
  {"column": "match_id",     "path": "$.match_id",     "datatype": "string"},
  {"column": "kind",         "path": "$.kind",         "datatype": "string"},
  {"column": "t_match",      "path": "$.t_match",      "datatype": "real"},
  {"column": "published_at", "path": "$.published_at", "datatype": "real"},
  {"column": "payload",      "path": "$.payload",      "datatype": "dynamic"}
]
```

// Raw envelopes are only a staging area. Tracking frames arrive at 10 a second per match.
.alter-merge table PitchsideRaw policy retention softdelete = 3d

// ---- match events, one row per event ----------------------------------------------------

.create-merge table MatchEvents (
    match_id: string,
    event_id: string,
    seq: long,
    t_match: real,
    minute: int,
    period: int,
    clock: string,
    type: string,
    team: string,
    player_id: string,
    x: real,
    y: real,
    end_x: real,
    end_y: real,
    outcome: string,
    receiver_id: string,
    under_pressure: bool,
    ball_speed_kmh: real,
    pass_difficulty: real,
    xg: real,
    tags: dynamic,
    source: string,
    published_at: datetime,
    landed_at: datetime
)

.create-or-alter function with (docstring = "Events out of the raw envelopes", folder = "pitchside")
ExpandEvents() {
    PitchsideRaw
    | where kind == "event"
    | extend p = payload
    | project
        match_id,
        event_id = tostring(p.event_id),
        seq = tolong(p.seq),
        t_match,
        minute = toint(floor(t_match / 60.0, 1)),
        period = toint(p.period),
        clock = tostring(p.clock),
        type = tostring(p.type),
        team = tostring(p.team),
        player_id = tostring(p.player_id),
        x = toreal(p.x),
        y = toreal(p.y),
        end_x = toreal(p.end_x),
        end_y = toreal(p.end_y),
        outcome = tostring(p.outcome),
        receiver_id = tostring(p.receiver_id),
        under_pressure = tobool(p.under_pressure),
        ball_speed_kmh = toreal(p.ball_speed_kmh),
        pass_difficulty = toreal(p.pass_difficulty),
        xg = toreal(p.xg),
        tags = p.tags,
        source = tostring(p.source),
        published_at = unixtime_seconds_todatetime(published_at),
        landed_at = now()
}

.alter table MatchEvents policy update
```
[{"IsEnabled": true, "Source": "PitchsideRaw", "Query": "ExpandEvents()", "IsTransactional": false, "PropagateIngestionProperties": false}]
```

// ---- ball positions, for the live heat map ------------------------------------------------

.create-merge table BallFrames (
    match_id: string,
    t_match: real,
    ball_x: real,
    ball_y: real,
    ball_z: real
)

.create-or-alter function with (docstring = "Ball position out of the tracking frames", folder = "pitchside")
ExpandBall() {
    PitchsideRaw
    | where kind == "frame"
    | project
        match_id,
        t_match,
        ball_x = toreal(payload.ball.x),
        ball_y = toreal(payload.ball.y),
        ball_z = toreal(payload.ball.z)
}

.alter table BallFrames policy update
```
[{"IsEnabled": true, "Source": "PitchsideRaw", "Query": "ExpandBall()", "IsTransactional": false, "PropagateIngestionProperties": false}]
```

.alter-merge table BallFrames policy retention softdelete = 7d
