// Measures for the "Northbridge League" Power BI report (docs/FABRIC.md, step 4).
// Semantic model over the lakehouse tables (Direct Lake). Relationships to set first:
//   team_match[team]      -> clubs[team]      (many to one)
//   team_match[match_id]  -> matches[match_id] (many to one)
//   events[match_id]      -> matches[match_id] (many to one)
//   events[team]          -> clubs[team]      (many to one)
//   events[player_id]     -> players[player_id] (many to one)
// Add each measure to the team_match table unless it says otherwise (New measure, paste).

Points = SUM ( team_match[points] )

Played = COUNTROWS ( team_match )

Points per game = DIVIDE ( [Points], [Played] )

Goals for = SUM ( team_match[goals_for] )

Goals against = SUM ( team_match[goals_against] )

Goal difference = [Goals for] - [Goals against]

xG for = SUM ( team_match[xg] )

// Finishing: goals scored above or below what the chances were worth.
Goals minus xG = [Goals for] - [xG for]

Shots per game = DIVIDE ( SUM ( team_match[shots] ), [Played] )

Shot accuracy % = DIVIDE ( SUM ( team_match[shots_on_target] ), SUM ( team_match[shots] ) ) * 100

Pass completion % = DIVIDE ( SUM ( team_match[passes_complete] ), SUM ( team_match[passes] ) ) * 100

Pass share % = AVERAGE ( team_match[pass_share_pct] )

Hard passes per game = DIVIDE ( SUM ( team_match[hard_passes_complete] ), [Played] )

Ball wins per game = DIVIDE ( SUM ( team_match[ball_wins] ), [Played] )

Cards per game = DIVIDE ( SUM ( team_match[yellows] ) + SUM ( team_match[reds] ), [Played] )

Win % = DIVIDE ( CALCULATE ( [Played], team_match[result] = "W" ), [Played] ) * 100

Home win % =
    DIVIDE (
        CALCULATE ( [Played], team_match[result] = "W", team_match[is_home] = 1 ),
        CALCULATE ( [Played], team_match[is_home] = 1 )
    ) * 100

// Rank in the league table, for the table visual's first column.
Position =
    RANKX (
        ALL ( clubs[club] ),
        [Points] * 10000 + [Goal difference] * 100 + [Goals for],
        ,
        DESC,
        Dense
    )

// On the events table: how hard a player's completed passes were on average.
Avg difficulty completed =
    CALCULATE (
        AVERAGE ( events[pass_difficulty] ),
        events[type] = "pass",
        events[outcome] = "complete"
    )
