{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "foundryProjectEndpoint": {
      "value": "${FOUNDRY_PROJECT_ENDPOINT}"
    },
    "apiMinReplicas": {
      "value": "${API_MIN_REPLICAS=0}"
    },
    "apiImage": {
      "value": "${SERVICE_API_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "mcpImage": {
      "value": "${SERVICE_MCP_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "a2aImage": {
      "value": "${SERVICE_A2A_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    }
  }
}
