# Copy to .env. Never commit .env.
# Prefer Managed Identity / DefaultAzureCredential in Azure; keys only for local dev.

# Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/pitchside
FOUNDRY_PROJECT_ENDPOINT=
# Endpoint for chat calls with Entra (keyless) auth: https://<resource>.cognitiveservices.azure.com/
# Calls go to <this>/openai/deployments/<deployment>/chat/completions?api-version=...
FOUNDRY_OPENAI_ENDPOINT=
# Small fast model for high-volume agents
FOUNDRY_DEPLOYMENT_FAST=chat-fast
# Optional: USD per million tokens (input:output) for the Control Room cost estimate.
# COST_PER_M_TOKENS=chat-fast=0.4:1.6,chat-strong=0.25:2.0
# Stronger model for the Analyst and recaps
FOUNDRY_DEPLOYMENT_STRONG=chat-strong

# Event Hubs namespace FQDN, e.g. <ns>.servicebus.windows.net
EVENTHUB_FQDN=
EVENTHUB_NAME=match-events

# Cosmos DB for NoSQL account endpoint
COSMOS_ENDPOINT=
COSMOS_DATABASE=pitchside

# Azure AI Translator
TRANSLATOR_ENDPOINT=
TRANSLATOR_REGION=

# Azure AI Speech. Voices and voice questions call the resource on TRANSLATOR_ENDPOINT above
# (one Foundry resource serves Translator, Speech and the models).
SPEECH_REGION=
SPEECH_RESOURCE_ID=

# Azure AI Content Safety
CONTENT_SAFETY_ENDPOINT=

# OpenTelemetry export to Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# memory | eventhubs
EVENT_BUS=memory
# local | cosmos
STORE=local
# on | off. Cache LLM outputs per (match_seed, moment_id, persona, language)
AGENT_CACHE=on

# Directory for the agent output cache (local runs)
AGENT_CACHE_DIR=

# Public URL of the gateway, shown in the A2A agent card
PUBLIC_BASE_URL=http://localhost:8000
# Set to off to run without any model calls
AGENTS=on

# Blob container that holds the real-footage clip (<base>/<clip>/clip.mp4); the gateway redirects to it
# when it has no local file. Output of infra/modules/storage.bicep.
REAL_VIDEO_BASE_URL=

# Rate limits on the endpoints that spend money (backend/app/ratelimit.py). Off unless RATE_LIMIT=on.
RATE_LIMIT=off
# Fresh match runs for the whole service, per hour
RATE_START_PER_HOUR=5
# Ask the Analyst (typed or spoken), per client per minute
RATE_ASK_PER_MIN=12
# Recaps, per client per minute
RATE_RECAP_PER_MIN=20
# Chaos switch, per client per minute
RATE_KILL_PER_MIN=10

# ---- 7. AI Search (league knowledge for Ask the Analyst) ----
# true | false. Off by default: Ask behaves exactly as before.
# true with no SEARCH_ENDPOINT uses the in-process keyword index (offline, no Azure).
SEARCH_ENABLED=false
# https://<name>.search.windows.net (the SEARCH_ENDPOINT output of azd provision). Keyless.
SEARCH_ENDPOINT=
SEARCH_INDEX=pitchside-knowledge

# ---- 5. Foundry depth (Agent Service, tracing) ----
# true | false. Off by default. When true (and FOUNDRY_PROJECT_ENDPOINT is set) the agents run
# as the prompt agents published by scripts/register_agents.py; any agent that is missing or
# out of date with the prompt in this checkout is called directly as before.
FOUNDRY_AGENT_SERVICE=false
# true | false. Off by default. Blocks links, emails, markup and read-back system prompts in
# viewer questions and in every line before it airs (backend/agents/guardrails.py).
GUARDRAILS=false
