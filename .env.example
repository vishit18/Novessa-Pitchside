# Copy to .env. Never commit .env.
# Prefer Managed Identity / DefaultAzureCredential in Azure; keys only for local dev.

# Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/pitchside
FOUNDRY_PROJECT_ENDPOINT=
# Endpoint for chat calls with Entra (keyless) auth: https://<resource>.cognitiveservices.azure.com/
# Calls go to <this>/openai/deployments/<deployment>/chat/completions?api-version=...
FOUNDRY_OPENAI_ENDPOINT=
# Small fast model for high-volume agents
FOUNDRY_DEPLOYMENT_FAST=chat-fast
# Stronger model for the Analyst and recaps
FOUNDRY_DEPLOYMENT_STRONG=chat-strong

# Event Hubs namespace FQDN, e.g. <ns>.servicebus.windows.net
EVENTHUB_FQDN=
EVENTHUB_NAME=match-events

# Cosmos DB for NoSQL account endpoint
COSMOS_ENDPOINT=
COSMOS_DATABASE=pitchside

# Azure AI Translator
TRANSLATOR_ENDPOINT=
TRANSLATOR_REGION=

# Azure AI Speech
SPEECH_REGION=
SPEECH_RESOURCE_ID=

# Azure AI Content Safety
CONTENT_SAFETY_ENDPOINT=

# OpenTelemetry export to Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# memory | eventhubs
EVENT_BUS=memory
# local | cosmos
STORE=local
# on | off. Cache LLM outputs per (match_seed, moment_id, persona, language)
AGENT_CACHE=on

# Directory for the agent output cache (local runs)
AGENT_CACHE_DIR=

# Public URL of the gateway, shown in the A2A agent card
PUBLIC_BASE_URL=http://localhost:8000
# Set to off to run without any model calls
AGENTS=on
